# --- Local development (defaults already match a local `npx hardhat node`) ---
RPC_URL=http://127.0.0.1:8545
NETWORK=localhost
PORT=4000

# Operator private key used by the backend to submit settleBatch() and to
# fund/register demo agents. Defaults to Hardhat's well-known local account
# #0 if unset — fine for local dev, NEVER use that default anywhere real.
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Testnet deployment (only needed for `--network baseSepolia`) ---
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
